# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Зөвхөн сервер талд. RLS-ийг тойрдог тул хэзээ ч клиент рүү гаргахгүй
SUPABASE_SERVICE_ROLE_KEY=

# Мэдэгдлийн имэйл илгээх Gmail (App Password). Resend ажиллахгүй үед OTP-г ч үүгээр илгээнэ
GMAIL_USER=
GMAIL_APP_PASSWORD=

# OTP (бүртгэлийн код, нууц үг сэргээх код)-ыг Resend-ээр өөрийн домэйноос илгээх. Заавал биш —
# хоосон бол Gmail ашиглана. Илгээгч хаяг нь Resend дээр баталгаажсан домэйн байх ёстой
RESEND_API_KEY=
RESEND_FROM=noreply@mstaffing.mn

# Session cookie-н гарын үсгийн түлхүүр (32+ тэмдэгт, production-д тусдаа утга өгнө)
# Үүсгэх: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Сайтын үндсэн хаяг (имэйл дэх линк, metadata, sitemap). Заавал биш — тохируулаагүй бол
# Vercel-ийн production домэйныг (VERCEL_PROJECT_PRODUCTION_URL) ашиглана. Жишээ: https://mstaffing.mn
APP_URL=

# Админ эрхтэй имэйлүүд, таслалаар тусгаарлана
ADMIN_EMAILS=

# Багц ахиулах үед компанид харуулах хүлээн авах данс
BILLING_BANK_NAME=
BILLING_ACCOUNT_NUMBER=
BILLING_ACCOUNT_NAME=
