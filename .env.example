# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Зөвхөн сервер талд. RLS-ийг тойрдог тул хэзээ ч клиент рүү гаргахгүй
SUPABASE_SERVICE_ROLE_KEY=

# Бүртгэлийн баталгаажуулах код илгээх Gmail (App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Session cookie-н гарын үсгийн түлхүүр (32+ тэмдэгт, production-д тусдаа утга өгнө)
# Үүсгэх: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Сайтын үндсэн хаяг (имэйл дэх линкүүдэд). Production-д заавал тохируулна —
# тохируулаагүй бол гэрээний мэдэгдлийн мэйл линкгүй явна. Жишээ: https://mstaffing.mn
APP_URL=

# Админ эрхтэй имэйлүүд, таслалаар тусгаарлана
ADMIN_EMAILS=

# Багц ахиулах үед компанид харуулах хүлээн авах данс
BILLING_BANK_NAME=
BILLING_ACCOUNT_NUMBER=
BILLING_ACCOUNT_NAME=
